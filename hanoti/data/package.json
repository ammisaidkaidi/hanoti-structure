{
  "name": "@app/data",
  "version": "0.1.0",
  "private": true,
  "description": "Server-only TypeORM entities, database helpers, SQL declarations, seeds and assets",
  "files": [
    "dist",
    "migrations",
    "seeds",
    "assets",
    "README.md",
    "TYPEORM.md"
  ],
  "dependencies": {
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "~5.9.3"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connection-policy": {
      "types": "./dist/connection-policy.d.ts",
      "import": "./dist/connection-policy.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @app/tests --fail-if-no-match test:data"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.11.0"
  }
}
