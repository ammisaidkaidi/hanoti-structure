{
  "name": "@app/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include \"../common/dist/**/*.js\" --include \"../../data/dist/**/*.js\" src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @app/tests --fail-if-no-match test:server",
    "db:backup": "tsx src/scripts/backup.ts",
    "db:backup:production": "node --enable-source-maps dist/scripts/backup.js"
  },
  "dependencies": {
    "@app/common": "workspace:*",
    "@app/data": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "8.23.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.12",
    "@types/pg": "8.23.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
