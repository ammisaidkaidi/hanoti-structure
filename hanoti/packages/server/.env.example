NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=http://localhost:5173
# Optional absolute path; defaults to the workspace data directory.
# DATA_DIR=/absolute/path/to/hanoti/data

# One database; API does not connect automatically.
# Supply DATABASE_URL to explicit ORM callers or to the standalone backup process.
# Use distinct least-privilege credentials for application and backup processes.
# DATABASE_URL=postgresql://appropriate_user:password@localhost:5432/hanouti
# Per pg_dump / pg_restore invocation; default 30 minutes, maximum 24 hours.
BACKUP_TIMEOUT_MS=1800000
